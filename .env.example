# ─── Сервер ──────────────────────────────────────────────────────────────────
TG_SERVER_HOST=0.0.0.0
TG_SERVER_PORT=8000
TG_SERVER_MAX_BODY_SIZE=1048576

# ─── Taiga ────────────────────────────────────────────────────────────────────
TG_TAIGA_BASE_URL=http://localhost:9000/api/v1
TG_TAIGA_USERNAME=username
TG_TAIGA_PASSWORD=password
TG_TAIGA_PROJECT_ID=2
TG_TAIGA_TARGET_STATUS=Ready for test

# ─── GitLab — условия фильтрации ─────────────────────────────────────────────
TG_GITLAB_MATCH_USER=FRONT_SCRIPT
TG_GITLAB_MATCH_REF=qa
TG_GITLAB_MATCH_STATUS=pending
TG_GITLAB_TASK_PATTERN=TG-(\d+)
